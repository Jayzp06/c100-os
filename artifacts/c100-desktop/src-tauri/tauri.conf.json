{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "C100 Operations",
  "version": "0.9.0-rc1",
  "identifier": "edu.fvsu.c100.operations",
  "build": {
    "frontendDist": "../../c100/dist/public",
    "devUrl": "http://localhost:23873",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "C100 Operations Console",
        "width": 1400,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 768,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; connect-src 'self' https://* http://localhost:* ws://localhost:*; img-src 'self' data: blob: https:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "entitlements": null,
      "exceptionDomain": "",
      "frameworks": [],
      "providerShortName": null,
      "signingIdentity": null
    },
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Jayzp06/c100-os/releases/latest/download/latest.json"
      ],
      "dialog": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc2M0RBM0ZEMjRFOUY0RDYKUldUVzlPa2svYU05ZHJDR0d5WDhJM3djWGpuZCtmYlpTdVJqcTd1blZuS3dkcmx4KzVFTDFXLy8K"
    },
    "deep-link": {
      "desktop": {
        "schemes": ["c100ops"]
      }
    }
  }
}
